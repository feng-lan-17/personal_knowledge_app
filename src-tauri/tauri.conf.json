{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "私人知识图书馆",
  "version": "0.1.1",
  "identifier": "app.private-knowledge-library",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43123",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "私人知识图书馆",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
